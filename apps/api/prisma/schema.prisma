// Phase 1 schema: tenants, branches, org structure, auth, RBAC, audit, settings.
// Later phases (products, inventory, purchase, sales, accounting...) extend this same file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & org structure
// ---------------------------------------------------------------------------

model Tenant {
  id                      String   @id @default(cuid())
  businessName            String
  legalName               String?
  ownerName               String?
  email                   String?
  phone                   String?
  website                 String?
  gstin                   String?
  pan                     String?
  drugLicenseNumber       String?
  fssaiLicenseNumber      String?
  address                 String?
  state                   String?
  district                String?
  city                    String?
  pincode                 String?
  logoUrl                 String?
  signatureUrl            String?
  invoiceFooter           String?
  termsAndConditions      String?
  // Indian FY defaults to April(4)-March; kept configurable per spec section 46.
  financialYearStartMonth Int      @default(4)
  isActive                Boolean  @default(true)
  // Human-readable store identifier for the Platform Admin ("Store 001" etc.), distinct from
  // the opaque cuid `id`. Assigned sequentially at tenant-creation time.
  storeCode               String   @unique
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  branches          Branch[]
  users             User[]
  roles             Role[]
  auditLogs         AuditLog[]
  settings          Setting[]
  manufacturers     Manufacturer[]
  productCategories ProductCategory[]
  units             Unit[]
  suppliers         Supplier[]
  products          Product[]
  batches           Batch[]
  stockTransactions StockTransaction[]
  stockTransfers    StockTransfer[]
  invoiceSequences  InvoiceSequence[]
  purchaseOrders    PurchaseOrder[]
  purchases         Purchase[]
  purchasePayments  PurchasePayment[]
  purchaseReturns   PurchaseReturn[]
  doctors           Doctor[]
  customers         Customer[]
  prescriptions     Prescription[]
  sales             Sale[]
  salePayments      SalePayment[]
  salesReturns      SalesReturn[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  receipts          Receipt[]
  supplierPayments  SupplierPayment[]
  cashSessions      CashSession[]
  notifications     Notification[]
  subscription      StoreSubscription?
  storePayments     StorePayment[]
  storeNotes        StoreNote[]

  @@map("tenants")
}

// Portable sequential-counter source for Tenant.storeCode (MySQL has no native sequences —
// each inserted row's auto-increment id serves as the next counter value, see lib/storeCode.ts).
model StoreCodeCounter {
  id Int @id @default(autoincrement())

  @@map("store_code_counters")
}

// ---------------------------------------------------------------------------
// Platform Super Admin — a single operator identity that sits OUTSIDE every tenant and
// manages stores (create/edit/activate/deactivate, reset passwords, impersonate for support).
// Deliberately has no relation to Tenant/User: it must never be confused with a tenant
// principal, and a tenant-issued JWT must never be accepted by platform-admin routes or
// vice versa (enforced by a separate signing secret too, see lib/platformJwt.ts).
// ---------------------------------------------------------------------------

model PlatformAdmin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  // A short, memorable login handle alongside email — login accepts either. Globally unique for
  // the same reason email is.
  username     String    @unique
  passwordHash String
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens PlatformRefreshToken[]

  @@map("platform_admins")
}

model PlatformRefreshToken {
  id              String    @id @default(cuid())
  platformAdminId String
  tokenHash       String    @unique
  userAgent       String?
  ipAddress       String?
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  platformAdmin PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  @@index([platformAdminId])
  @@map("platform_refresh_tokens")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

// What a store pays the Platform Admin to use this CRM. One row per tenant — the Platform
// Admin sets the plan/amount/due date manually (this is bookkeeping for the admin, not a
// payment gateway integration).
model StoreSubscription {
  id           String             @id @default(cuid())
  tenantId     String             @unique
  planName     String             @default("Standard")
  billingCycle BillingCycle       @default(MONTHLY)
  amount       Decimal            @db.Decimal(12, 2)
  status       SubscriptionStatus @default(TRIAL)
  startDate    DateTime           @default(now())
  nextDueDate  DateTime?
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("store_subscriptions")
}

// Payment history ledger for a store's subscription — recorded by the Platform Admin when a
// store pays. Recording a payment also pushes StoreSubscription.nextDueDate forward.
model StorePayment {
  id              String      @id @default(cuid())
  tenantId        String
  amount          Decimal     @db.Decimal(12, 2)
  paymentDate     DateTime    @default(now())
  paymentMode     PaymentMode
  referenceNumber String?
  notes           String?
  createdAt       DateTime    @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, paymentDate])
  @@map("store_payments")
}

// Internal, append-only support notes a Platform Admin leaves on a store ("called about billing
// issue", etc.) — never visible to the store itself, purely for the admin's own record-keeping.
// No platformAdminId FK: there is exactly one Platform Admin by design (see PlatformAdmin's own
// comment), so the name is captured as a plain string at write time rather than relating to a
// row that could theoretically be deleted/recreated.
model StoreNote {
  id              String   @id @default(cuid())
  tenantId        String
  note            String   @db.Text
  createdByName   String
  createdByEmail  String
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("store_notes")
}

model Branch {
  id                    String   @id @default(cuid())
  tenantId              String
  name                  String
  address               String?
  gstin                 String?
  drugLicenseNumber     String?
  pharmacyLicenseNumber String?
  contactNumber         String?
  email                 String?
  invoicePrefix         String?
  bankName              String?
  bankAccountNumber     String?
  bankIfsc              String?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouses        Warehouse[]
  counters          Counter[]
  userBranches      UserBranch[]
  auditLogs         AuditLog[]
  settings          Setting[]
  batches           Batch[]
  stockTransactions StockTransaction[]
  transfersOut      StockTransfer[]    @relation("TransferFrom")
  transfersIn       StockTransfer[]    @relation("TransferTo")
  invoiceSequences  InvoiceSequence[]
  purchaseOrders    PurchaseOrder[]
  purchases         Purchase[]
  purchaseReturns   PurchaseReturn[]
  prescriptions     Prescription[]
  sales             Sale[]
  salesReturns      SalesReturn[]
  expenses          Expense[]
  receipts          Receipt[]
  supplierPayments  SupplierPayment[]
  cashSessions      CashSession[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("branches")
}

model Warehouse {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String
  name      String
  location  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  batches Batch[]

  @@unique([branchId, name])
  @@index([tenantId])
  @@map("warehouses")
}

model Counter {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sales        Sale[]
  cashSessions CashSession[]

  @@unique([branchId, name])
  @@index([tenantId])
  @@map("counters")
}

// ---------------------------------------------------------------------------
// Auth & RBAC
// ---------------------------------------------------------------------------

model User {
  id                 String    @id @default(cuid())
  tenantId           String
  name               String
  email              String
  // A short, memorable login handle alongside email — login accepts either. Globally unique for
  // the same reason email is (login looks a user up before knowing their tenant).
  username           String    @unique
  phone              String?
  passwordHash       String
  roleId             String
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role          Role           @relation(fields: [roleId], references: [id])
  userBranches  UserBranch[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  notifications Notification[]

  // Email is globally unique (not just per tenant) so login can look a user up by email
  // alone before knowing which tenant they belong to.
  @@unique([email])
  @@index([tenantId])
  @@index([roleId])
  @@map("users")
}

// Which branches a user may operate in. Empty = no branch access (must be assigned explicitly).
model UserBranch {
  id       String @id @default(cuid())
  userId   String
  branchId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@map("user_branches")
}

model Role {
  id                   String   @id @default(cuid())
  tenantId             String
  name                 String
  // Default/system roles seeded per tenant can't be deleted, only permission-edited.
  isSystem             Boolean  @default(false)
  discountLimitPercent Decimal  @default(0) @db.Decimal(5, 2)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users           User[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

// Global catalog of (module, action) pairs — seeded once, shared across all tenants.
model Permission {
  id     String @id @default(cuid())
  module String
  action String
  code   String @unique // e.g. "products.edit"

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String  @id @default(cuid())
  roleId       String
  permissionId String
  allowed      Boolean @default(true)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Cross-cutting: audit log & settings
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  branchId   String?
  module     String
  action     String
  entityType String?
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}

// Tenant-wide setting when branchId is null, branch-specific override otherwise.
model Setting {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String?
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId, key])
  @@map("settings")
}

// ---------------------------------------------------------------------------
// Phase 2: product master, batches, inventory (FEFO), stock transfer
// ---------------------------------------------------------------------------

model Manufacturer {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]
  batches  Batch[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("manufacturers")
}

model ProductCategory {
  id               String   @id @default(cuid())
  tenantId         String
  name             String
  parentCategoryId String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentCategory ProductCategory?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  subCategories  ProductCategory[] @relation("CategoryHierarchy")
  products       Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("product_categories")
}

model Unit {
  id        String   @id @default(cuid())
  tenantId  String
  name      String // e.g. "Strip", "Bottle", "Box", "Tablet", "ml"
  shortCode String? // e.g. "STR", "BTL"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("product_units")
}

// Minimal for now (Phase 2 only needs a batch->supplier reference); Phase 3 (Purchase)
// extends this with credit terms, ledger, etc.
model Supplier {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  gstin          String?
  pan            String?
  drugLicense    String?
  creditLimit    Decimal  @default(0) @db.Decimal(12, 2)
  creditDays     Int      @default(0)
  openingBalance Decimal  @default(0) @db.Decimal(12, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batches          Batch[]
  purchaseOrders   PurchaseOrder[]
  purchases        Purchase[]
  purchaseReturns  PurchaseReturn[]
  supplierPayments SupplierPayment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("suppliers")
}

model Product {
  id                   String   @id @default(cuid())
  tenantId             String
  sku                  String
  name                 String
  genericName          String?
  brandName            String?
  manufacturerId       String?
  categoryId           String?
  unitId               String?
  composition          String?
  strength             String?
  dosageForm           String?
  hsnCode              String?
  gstRatePercent       Decimal  @default(0) @db.Decimal(5, 2)
  scheduleType         String?
  requiresPrescription Boolean  @default(false)
  isControlled         Boolean  @default(false)
  isNarcotic           Boolean  @default(false)
  isRefrigerated       Boolean  @default(false)
  packSize             String?
  mrp                  Decimal  @db.Decimal(12, 2)
  purchasePrice        Decimal  @db.Decimal(12, 2)
  sellingPrice         Decimal  @db.Decimal(12, 2)
  wholesalePrice       Decimal? @db.Decimal(12, 2)
  minSellingPrice      Decimal? @db.Decimal(12, 2)
  reorderLevel         Int      @default(0)
  maxStockLevel        Int?
  rackLocation         String?
  imageUrl             String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  manufacturer        Manufacturer?        @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  category            ProductCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit                Unit?                @relation(fields: [unitId], references: [id], onDelete: SetNull)
  barcodes            ProductBarcode[]
  batches             Batch[]
  stockTransactions   StockTransaction[]
  stockTransferItems  StockTransferItem[]
  purchaseOrderItems  PurchaseOrderItem[]
  purchaseItems       PurchaseItem[]
  purchaseReturnItems PurchaseReturnItem[]
  prescriptionItems   PrescriptionItem[]
  saleItems           SaleItem[]
  salesReturnItems    SalesReturnItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, name])
  @@map("products")
}

model ProductBarcode {
  id        String @id @default(cuid())
  productId String
  barcode   String @unique

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_barcodes")
}

model Batch {
  id                   String    @id @default(cuid())
  tenantId             String
  branchId             String
  warehouseId          String?
  productId            String
  batchNumber          String
  manufacturerId       String?
  supplierId           String?
  mfgDate              DateTime?
  expiryDate           DateTime
  purchaseRate         Decimal   @db.Decimal(12, 2)
  mrp                  Decimal   @db.Decimal(12, 2)
  gstRatePercent       Decimal   @default(0) @db.Decimal(5, 2)
  // Current sellable quantity. The authoritative history of how it got here lives in
  // StockTransaction; this column is a denormalized running total for fast reads, always
  // updated inside the same transaction as the StockTransaction row that explains the change.
  quantity             Int       @default(0)
  freeQuantityReceived Int       @default(0)
  isBlocked            Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch              Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  warehouse           Warehouse?           @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  product             Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  manufacturer        Manufacturer?        @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  supplier            Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  stockTransactions   StockTransaction[]
  transferItems       StockTransferItem[]
  purchaseItems       PurchaseItem[]
  purchaseReturnItems PurchaseReturnItem[]
  saleItems           SaleItem[]
  salesReturnItems    SalesReturnItem[]

  @@unique([branchId, productId, batchNumber])
  @@index([tenantId, branchId])
  @@index([productId])
  @@index([expiryDate])
  @@index([supplierId])
  @@index([manufacturerId])
  @@map("batches")
}

enum StockTransactionType {
  OPENING
  PURCHASE
  PURCHASE_RETURN
  SALE
  SALE_RETURN
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
}

enum AdjustmentReason {
  DAMAGED
  EXPIRED
  LOST
  FOUND
  CORRECTION
  OTHER
}

// Append-only ledger: every stock change (spec section 55.7). `quantity` is signed
// (positive = stock in, negative = stock out).
model StockTransaction {
  id            String               @id @default(cuid())
  tenantId      String
  branchId      String
  productId     String
  batchId       String
  type          StockTransactionType
  quantity      Int
  reason        AdjustmentReason?
  referenceType String?
  referenceId   String?
  notes         String?
  createdById   String?
  createdAt     DateTime             @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([tenantId, branchId, createdAt])
  @@index([batchId])
  @@index([productId])
  @@map("stock_transactions")
}

enum StockTransferStatus {
  REQUESTED
  APPROVED
  REJECTED
  DISPATCHED
  RECEIVED
  CANCELLED
}

model StockTransfer {
  id            String              @id @default(cuid())
  tenantId      String
  fromBranchId  String
  toBranchId    String
  status        StockTransferStatus @default(REQUESTED)
  requestedById String?
  approvedById  String?
  notes         String?
  dispatchedAt  DateTime?
  receivedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromBranch Branch              @relation("TransferFrom", fields: [fromBranchId], references: [id], onDelete: Cascade)
  toBranch   Branch              @relation("TransferTo", fields: [toBranchId], references: [id], onDelete: Cascade)
  items      StockTransferItem[]

  @@index([tenantId])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@map("stock_transfers")
}

// ---------------------------------------------------------------------------
// Phase 3: purchase workflow (PO -> goods receipt/invoice -> stock -> payment)
// ---------------------------------------------------------------------------

enum DocumentType {
  PURCHASE_ORDER
  PURCHASE
  PURCHASE_RETURN
  SALE
  SALE_RETURN
}

// Financial-year-aware auto-increment per (tenant, branch, document type), so numbers reset
// each FY per spec section 46 (e.g. INV/2026-27/000001). One row per FY; `lastNumber` is
// incremented inside a transaction by lib/documentNumber.ts.
model InvoiceSequence {
  id            String       @id @default(cuid())
  tenantId      String
  branchId      String
  docType       DocumentType
  financialYear String // e.g. "2026-27"
  prefix        String
  lastNumber    Int          @default(0)
  updatedAt     DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId, docType, financialYear])
  @@map("invoice_sequences")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  tenantId     String
  branchId     String
  supplierId   String
  orderNumber  String
  status       PurchaseOrderStatus @default(DRAFT)
  orderDate    DateTime            @default(now())
  expectedDate DateTime?
  notes        String?
  createdById  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  items     PurchaseOrderItem[]
  purchases Purchase[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, branchId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  rate            Decimal @db.Decimal(12, 2)
  notes           String?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

enum PurchaseStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMode {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
  CREDIT
  OTHER
}

model Purchase {
  id                    String         @id @default(cuid())
  tenantId              String
  branchId              String
  supplierId            String
  purchaseOrderId       String?
  referenceNumber       String // internal auto-generated reference (see InvoiceSequence)
  supplierInvoiceNumber String? // the supplier's own invoice number, free text
  purchaseDate          DateTime       @default(now())
  subtotal              Decimal        @default(0) @db.Decimal(14, 2)
  discountAmount        Decimal        @default(0) @db.Decimal(14, 2)
  taxAmount             Decimal        @default(0) @db.Decimal(14, 2)
  freightCharges        Decimal        @default(0) @db.Decimal(14, 2)
  otherCharges          Decimal        @default(0) @db.Decimal(14, 2)
  totalAmount           Decimal        @default(0) @db.Decimal(14, 2)
  paidAmount            Decimal        @default(0) @db.Decimal(14, 2)
  paymentStatus         PaymentStatus  @default(UNPAID)
  status                PurchaseStatus @default(CONFIRMED)
  notes                 String?
  createdById           String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  tenant                     Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                     Branch                      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplier                   Supplier                    @relation(fields: [supplierId], references: [id])
  purchaseOrder              PurchaseOrder?              @relation(fields: [purchaseOrderId], references: [id])
  items                      PurchaseItem[]
  payments                   PurchasePayment[]
  returns                    PurchaseReturn[]
  supplierPaymentAllocations SupplierPaymentAllocation[]

  @@unique([tenantId, referenceNumber])
  @@index([tenantId, branchId])
  @@index([supplierId])
  @@map("purchases")
}

model PurchaseItem {
  id              String    @id @default(cuid())
  purchaseId      String
  productId       String
  batchId         String?
  batchNumber     String
  mfgDate         DateTime?
  expiryDate      DateTime
  quantity        Int
  freeQuantity    Int       @default(0)
  purchaseRate    Decimal   @db.Decimal(12, 2)
  mrp             Decimal   @db.Decimal(12, 2)
  discountPercent Decimal   @default(0) @db.Decimal(5, 2)
  gstRatePercent  Decimal   @default(0) @db.Decimal(5, 2)
  lineTotal       Decimal   @db.Decimal(14, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch    Batch?   @relation(fields: [batchId], references: [id])

  @@index([purchaseId])
  @@map("purchase_items")
}

model PurchasePayment {
  id              String      @id @default(cuid())
  tenantId        String
  purchaseId      String
  amount          Decimal     @db.Decimal(14, 2)
  paymentMode     PaymentMode
  paymentDate     DateTime    @default(now())
  referenceNumber String?
  notes           String?
  createdById     String?
  createdAt       DateTime    @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@map("purchase_payments")
}

model PurchaseReturn {
  id              String   @id @default(cuid())
  tenantId        String
  branchId        String
  supplierId      String
  purchaseId      String?
  referenceNumber String
  returnDate      DateTime @default(now())
  reason          String?
  totalAmount     Decimal  @default(0) @db.Decimal(14, 2)
  createdById     String?
  createdAt       DateTime @default(now())

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplier Supplier             @relation(fields: [supplierId], references: [id])
  purchase Purchase?            @relation(fields: [purchaseId], references: [id])
  items    PurchaseReturnItem[]

  @@unique([tenantId, referenceNumber])
  @@index([tenantId, branchId])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id               String  @id @default(cuid())
  purchaseReturnId String
  productId        String
  batchId          String
  quantity         Int
  rate             Decimal @db.Decimal(12, 2)
  lineTotal        Decimal @db.Decimal(14, 2)

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch          Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([purchaseReturnId])
  @@map("purchase_return_items")
}

// ---------------------------------------------------------------------------
// Phase 4: customers, doctors, prescriptions, POS/sales, sales returns
// ---------------------------------------------------------------------------

model Doctor {
  id                 String   @id @default(cuid())
  tenantId           String
  name               String
  registrationNumber String?
  specialization     String?
  hospitalClinic     String?
  phone              String?
  email              String?
  address            String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customers     Customer[]
  prescriptions Prescription[]
  sales         Sale[]

  @@index([tenantId])
  @@map("doctors")
}

model Customer {
  id            String    @id @default(cuid())
  tenantId      String
  name          String
  mobile        String?
  email         String?
  address       String?
  dob           DateTime?
  gender        String?
  bloodGroup    String?
  doctorId      String?
  notes         String?
  creditLimit   Decimal   @default(0) @db.Decimal(12, 2)
  creditDays    Int       @default(0)
  loyaltyPoints Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  doctor        Doctor?        @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  prescriptions Prescription[]
  sales         Sale[]
  salesReturns  SalesReturn[]
  receipts      Receipt[]

  @@index([tenantId])
  @@index([tenantId, mobile])
  @@map("customers")
}

model Prescription {
  id                 String   @id @default(cuid())
  tenantId           String
  branchId           String
  customerId         String
  doctorId           String?
  prescriptionDate   DateTime @default(now())
  prescriptionNumber String?
  imageUrl           String?
  notes              String?
  createdById        String?
  createdAt          DateTime @default(now())

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  doctor   Doctor?            @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  items    PrescriptionItem[]
  sales    Sale[]

  @@index([tenantId, branchId])
  @@index([customerId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String  @id @default(cuid())
  prescriptionId String
  productId      String?
  medicineName   String
  dose           String?
  frequency      String?
  duration       String?
  instructions   String?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([prescriptionId])
  @@map("prescription_items")
}

enum InvoiceType {
  CASH
  CREDIT
  TAX
  RETAIL
  WHOLESALE
}

enum SaleStatus {
  CONFIRMED
  CANCELLED
}

model Sale {
  id             String        @id @default(cuid())
  tenantId       String
  branchId       String
  counterId      String?
  customerId     String?
  doctorId       String?
  prescriptionId String?
  invoiceNumber  String
  invoiceType    InvoiceType   @default(CASH)
  saleDate       DateTime      @default(now())
  subtotal       Decimal       @default(0) @db.Decimal(14, 2)
  discountAmount Decimal       @default(0) @db.Decimal(14, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(14, 2)
  totalAmount    Decimal       @default(0) @db.Decimal(14, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(14, 2)
  paymentStatus  PaymentStatus @default(UNPAID)
  status         SaleStatus    @default(CONFIRMED)
  cancelReason   String?
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  counter            Counter?            @relation(fields: [counterId], references: [id], onDelete: SetNull)
  customer           Customer?           @relation(fields: [customerId], references: [id])
  doctor             Doctor?             @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  prescription       Prescription?       @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  items              SaleItem[]
  payments           SalePayment[]
  returns            SalesReturn[]
  receiptAllocations ReceiptAllocation[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, branchId])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id              String  @id @default(cuid())
  saleId          String
  productId       String
  batchId         String
  quantity        Int
  freeQuantity    Int     @default(0)
  mrp             Decimal @db.Decimal(12, 2)
  sellingPrice    Decimal @db.Decimal(12, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  gstRatePercent  Decimal @default(0) @db.Decimal(5, 2)
  lineTotal       Decimal @db.Decimal(14, 2)

  sale             Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch            Batch             @relation(fields: [batchId], references: [id], onDelete: Cascade)
  salesReturnItems SalesReturnItem[]

  @@index([saleId])
  @@map("sale_items")
}

model SalePayment {
  id              String      @id @default(cuid())
  tenantId        String
  saleId          String
  amount          Decimal     @db.Decimal(14, 2)
  paymentMode     PaymentMode
  paymentDate     DateTime    @default(now())
  referenceNumber String?
  notes           String?
  createdById     String?
  createdAt       DateTime    @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("sale_payments")
}

enum SalesReturnStatus {
  PENDING
  APPROVED
  REJECTED
}

model SalesReturn {
  id              String            @id @default(cuid())
  tenantId        String
  branchId        String
  saleId          String
  customerId      String?
  referenceNumber String
  returnDate      DateTime          @default(now())
  reason          String?
  totalAmount     Decimal           @default(0) @db.Decimal(14, 2)
  refundAmount    Decimal           @default(0) @db.Decimal(14, 2)
  status          SalesReturnStatus @default(PENDING)
  approvedById    String?
  createdById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sale     Sale              @relation(fields: [saleId], references: [id])
  customer Customer?         @relation(fields: [customerId], references: [id])
  items    SalesReturnItem[]

  @@unique([tenantId, referenceNumber])
  @@index([tenantId, branchId])
  @@map("sales_returns")
}

model SalesReturnItem {
  id            String  @id @default(cuid())
  salesReturnId String
  saleItemId    String
  productId     String
  batchId       String
  quantity      Int
  rate          Decimal @db.Decimal(12, 2)
  lineTotal     Decimal @db.Decimal(14, 2)

  salesReturn SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  saleItem    SaleItem    @relation(fields: [saleItemId], references: [id])
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch       Batch       @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([salesReturnId])
  @@index([saleItemId])
  @@map("sales_return_items")
}

// ---------------------------------------------------------------------------
// Phase 5: expenses, customer receipts, supplier payments, cash sessions
// ---------------------------------------------------------------------------

model ExpenseCategory {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("expense_categories")
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

model Expense {
  id           String        @id @default(cuid())
  tenantId     String
  branchId     String
  categoryId   String
  amount       Decimal       @db.Decimal(12, 2)
  paymentMode  PaymentMode
  expenseDate  DateTime      @default(now())
  description  String?
  receiptUrl   String?
  status       ExpenseStatus @default(PENDING)
  approvedById String?
  createdById  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([tenantId, branchId])
  @@map("expenses")
}

// A single customer payment that may pay off several outstanding invoices at once (oldest
// first). Each allocation also creates a matching SalePayment row so that invoice's own
// paidAmount/paymentStatus stay authoritative — this table is the printable receipt header.
model Receipt {
  id              String      @id @default(cuid())
  tenantId        String
  branchId        String
  customerId      String
  amount          Decimal     @db.Decimal(12, 2)
  paymentMode     PaymentMode
  receiptDate     DateTime    @default(now())
  referenceNumber String?
  notes           String?
  createdById     String?
  createdAt       DateTime    @default(now())

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer    Customer            @relation(fields: [customerId], references: [id])
  allocations ReceiptAllocation[]

  @@index([tenantId, branchId])
  @@map("receipts")
}

model ReceiptAllocation {
  id        String  @id @default(cuid())
  receiptId String
  saleId    String
  amount    Decimal @db.Decimal(12, 2)

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@map("receipt_allocations")
}

// Mirror of Receipt, but for paying suppliers (also FIFO across their oldest unpaid purchases).
model SupplierPayment {
  id              String      @id @default(cuid())
  tenantId        String
  branchId        String
  supplierId      String
  amount          Decimal     @db.Decimal(12, 2)
  paymentMode     PaymentMode
  paymentDate     DateTime    @default(now())
  referenceNumber String?
  notes           String?
  createdById     String?
  createdAt       DateTime    @default(now())

  tenant      Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch                      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplier    Supplier                    @relation(fields: [supplierId], references: [id])
  allocations SupplierPaymentAllocation[]

  @@index([tenantId, branchId])
  @@map("supplier_payments")
}

model SupplierPaymentAllocation {
  id                String  @id @default(cuid())
  supplierPaymentId String
  purchaseId        String
  amount            Decimal @db.Decimal(12, 2)

  supplierPayment SupplierPayment @relation(fields: [supplierPaymentId], references: [id], onDelete: Cascade)
  purchase        Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([supplierPaymentId])
  @@map("supplier_payment_allocations")
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

model CashSession {
  id                    String            @id @default(cuid())
  tenantId              String
  branchId              String
  counterId             String
  openedById            String
  openingAmount         Decimal           @db.Decimal(12, 2)
  openedAt              DateTime          @default(now())
  closedById            String?
  closingAmount         Decimal?          @db.Decimal(12, 2)
  expectedClosingAmount Decimal?          @db.Decimal(12, 2)
  variance              Decimal?          @db.Decimal(12, 2)
  closedAt              DateTime?
  status                CashSessionStatus @default(OPEN)
  notes                 String?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  counter Counter @relation(fields: [counterId], references: [id])

  @@index([tenantId, branchId])
  @@index([counterId, status])
  @@map("cash_sessions")
}

// ---------------------------------------------------------------------------
// Phase 7: in-app notifications
// ---------------------------------------------------------------------------

// Tenant-wide by default (userId null); visibility is gated by the notifications.view
// permission on read, not by targeting individual users — simple broadcast model.
model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("notifications")
}

model StockTransferItem {
  id         String @id @default(cuid())
  transferId String
  productId  String
  batchId    String
  quantity   Int

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch    Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@map("stock_transfer_items")
}
