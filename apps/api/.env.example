# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL="postgresql://pharmacy_erp:password@localhost:5432/pharmacy_erp?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="changeme-access-secret"
JWT_REFRESH_SECRET="changeme-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Platform Super Admin auth — deliberately a different secret from JWT_ACCESS_SECRET.
PLATFORM_JWT_ACCESS_SECRET="changeme-platform-access-secret"
PLATFORM_JWT_ACCESS_EXPIRES_IN="30m"
PLATFORM_JWT_REFRESH_EXPIRES_IN="7d"

PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"
